{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with demo and real balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "surname": { "type": "string" },
        "birthDate": { "type": "string" },
        "photoURL": { "type": "string" },
        "photoUrl": { "type": "string" },
        "currency": { "type": "string", "enum": ["TL", "USD"] },
        "demoBalance": { "type": "number" },
        "realBalance": { "type": "number" },
        "totalDeposited": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "createdAt": { "type": "number" },
        "kycStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "kycDetails": { "type": "object" }
      },
      "required": ["email", "name", "surname", "birthDate", "currency", "demoBalance", "realBalance", "createdAt"]
    },
    "ObyoRequest": {
      "title": "ObyoRequest",
      "description": "Deposit and withdrawal request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "method": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userEmail", "userName", "type", "amount", "currency", "method", "status", "createdAt"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Admin-configured deposit payment accounts and wallet addresses",
      "type": "object",
      "properties": {
        "ibanBank": { "type": "string" },
        "ibanHolder": { "type": "string" },
        "ibanNumber": { "type": "string" },
        "ibanDescription": { "type": "string" },
        "ibanSwift": { "type": "string" },
        "trc20Address": { "type": "string" },
        "erc20Address": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and balances"
    },
    "/requests/{requestId}": {
      "schema": "ObyoRequest",
      "description": "Deposit and withdrawal transaction requests"
    },
    "/settings/payment": {
      "schema": "PaymentSettings",
      "description": "Global payment deposit details"
    }
  }
}
